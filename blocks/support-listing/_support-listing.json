        },
        {
          "component": "aem-content",
          "name": "ctaLink",
          "label": "Call to Action",
          "valueType": "string",
          "rootPath": "/content/enabling-guide-eds"
        },
        {
          "component": "text",
          "name": "ctaLinkText",
          "label": "CTA Label",
          "description": "Named ctaLinkText so it collapses into the link's own cell, keeping the card within the four-cell limit. The button appears only when both are set.",
          "valueType": "string"
        }
