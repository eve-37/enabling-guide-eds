{
  "definitions": [
    {
      "title": "Event Listing",
      "id": "event-listing",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Event Listing",
              "model": "event-listing",
              "filter": "event-listing",
              "pagePath": "",
              "mode": "children"
            }
          }
        }
      }
    },
    {
      "title": "Quote Card",
      "id": "event-listing-quote",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Quote Card",
              "model": "event-listing-quote",
              "quote": "",
              "personName": "",
              "position": "",
              "image": "",
              "imageAlt": ""
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "event-listing",
      "fields": [
        {
          "component": "aem-content",
          "name": "pagePath",
          "label": "Events source",
          "description": "In Child pages mode, the parent whose children are listed. In Single page mode, one event page.",
          "valueType": "string",
          "required": true,
          "rootPath": "/content/enabling-guide-eds"
        },
        {
          "component": "select",
          "name": "mode",
          "label": "Mode",
          "valueType": "string",
          "value": "children",
          "options": [
            { "name": "Child pages", "value": "children" },
            { "name": "Single page", "value": "page" }
          ]
        }
      ]
    },
    {
      "id": "event-listing-quote",
      "fields": [
        {
          "component": "richtext",
          "name": "quote",
          "label": "Quote",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "personName",
          "label": "Name",
          "description": "Not called 'name': that key is reserved on the template for the block's own name, which is how Edge Delivery finds its JavaScript and CSS.",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "position",
          "label": "Position / Role",
          "description": "For example, Caregiver.",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "description": "Photo behind the quote card.",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "event-listing",
      "components": [
        "event-listing-quote"
      ]
    }
  ]
